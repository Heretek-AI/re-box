# re-box M5: every REA_* engine path (IMPLEMENTATION_PROMPT Sec 4.4) in one file.
#
# Sourced by login shells via /etc/profile.d/re-box-env.sh (COPY of this file)
# and mirrored as Docker ENV lines so non-login shells and `opencode` itself
# see identical values. Each path is absolute and must exist in the built
# image — scripts/healthcheck.mjs fails the build (and the Docker HEALTHCHECK)
# if any entry is missing.
#
# Intentionally UNSET (REA rejects a compiler spec without its language id,
# rea/src/config/environment.ts:181-189):
#   REA_GHIDRA_COMPILER_SPEC_ID
#   REA_GHIDRA_LANGUAGE_ID
#
# Licensed / host-side tools are NEVER baked in — mount at runtime instead:
#   REA_IDA_MCP_CONFIG   -> -v /path/to/ida-mcp.json:... (IDA MCP bridge config)
#   HOPPER_LAUNCHER_PATH -> -v /path/to/hopper:/opt/hopper:ro (Hopper launcher)
# macOS-only targets (ipatool, Apple bundle analysis, Hopper GUI) stay host-side.

# --- Core installs -----------------------------------------------------------
export GHIDRA_INSTALL_DIR=/opt/ghidra_12.1.4_PUBLIC
export JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
export REA_JADX_MCP_JAR=/opt/jadx/jadx-headless-mcp-0.7.1-all.jar

# --- Disassemblers / debuggers ----------------------------------------------
export REA_RIZIN_COMMAND=/opt/rizin-0.9.1/bin/rizin
export REA_OBJDUMP_COMMAND=/usr/bin/objdump
export REA_GDB_COMMAND=/usr/bin/gdb

# --- Python providers (single venv /opt/venvs/re-tools) ----------------------
export REA_PWNTOOLS_PYTHON=/opt/venvs/re-tools/bin/python
export REA_MITMDUMP_COMMAND=/opt/venvs/re-tools/bin/mitmdump
export REA_UNBLOB_COMMAND=/opt/venvs/re-tools/bin/unblob

# --- pwndbg (latest release clone at /opt/pwndbg) -----------------------------
export REA_PWNDBG_GDB=/usr/bin/gdb
export REA_PWNDBG_GDBINIT=/opt/pwndbg/gdbinit.py
export REA_PWNDBG_VENV_PATH=/opt/pwndbg/.venv

# --- Firmware -----------------------------------------------------------------
export REA_BINWALK_COMMAND=/opt/binwalk/bin/binwalk

# --- Android -------------------------------------------------------------------
export REA_APKTOOL_COMMAND=/usr/local/bin/apktool
export REA_ADB_PATH=/usr/bin/adb

# --- Network / signals (absolute paths required, Gotcha 17) -------------------
export REA_TSHARK_COMMAND=/usr/bin/tshark
export REA_CAPINFOS_COMMAND=/usr/bin/capinfos
export REA_SIGROK_COMMAND=/usr/bin/sigrok-cli

# --- JS / WASM ------------------------------------------------------------------
export REA_WAKARU_COMMAND=/opt/wakaru/wakaru
export REA_WABT_BIN_DIRECTORY=/opt/wabt-1.0.42/bin

# --- prlimit overrides (default /usr/bin/prlimit; explicit for auditability) ---
export REA_TSHARK_PRLIMIT_COMMAND=/usr/bin/prlimit
export REA_SIGROK_PRLIMIT_COMMAND=/usr/bin/prlimit
export REA_JAVASCRIPT_PRLIMIT_COMMAND=/usr/bin/prlimit
export REA_FIRMWARE_PRLIMIT_COMMAND=/usr/bin/prlimit
export REA_EVM_PRLIMIT_COMMAND=/usr/bin/prlimit

# --- M7 complementary triage (opt-in via REBOX_WITH_*=1; lean images skip) -----
# ReVa headless MCP (mcp-reva, extension built against the baked Ghidra) and
# DIE console triage (diec). Both are absolute command paths; the healthcheck
# treats them as optional (warn, do not fail) so ARG=0 lean images stay green.
export REVA_COMMAND=/usr/local/bin/mcp-reva
export DIEC_COMMAND=/usr/local/bin/diec

# --- MCP schema profile (Sec 4.4a; not a path — healthcheck skips it) ----------
export REA_MCP_INPUT_SCHEMA_PROFILE=compact
